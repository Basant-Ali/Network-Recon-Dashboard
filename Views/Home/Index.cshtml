@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold">
            Network & Web Reconnaissance Dashboard
        </h1>

        <p class="lead text-muted">
            .NET Security Reconnaissance Platform
        </p>

    </div>


    <!-- Main Cards -->

    <div class="row justify-content-center g-5">

        <!-- Network Recon -->

        <div class="col-md-5">

            <div class="card shadow-sm h-100 p-4">

                <div class="card-body text-center">

                    <h2 class="mb-3">
                        Network Recon
                    </h2>

                    <p class="text-muted mb-4">
                        DNS Resolution, Ping and Port Scanning.
                    </p>

                    <a asp-controller="Recon"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        Start Network Recon

                    </a>

                </div>

            </div>

        </div>


        <!-- Web Security -->

        <div class="col-md-5">

            <div class="card shadow-sm h-100 p-4">

                <div class="card-body text-center">

                    <h2 class="mb-3">
                        Web Security
                    </h2>

                    <p class="text-muted mb-4">
                        Basic Web Security Testing.
                    </p>

                    <a asp-controller="WebSecurity"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        Start Web Security

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>